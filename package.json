{
  "name": "mattergram",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "generate-vapid": "node -e \"import('web-push').then(wp => console.log(JSON.stringify(wp.default.generateVAPIDKeys(), null, 2)))\""
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@vueuse/core": "^11.1.0",
    "date-fns": "^4.1.0",
    "highlight.js": "^11.12.0",
    "http-proxy": "^1.18.1",
    "lucide-vue-next": "^0.451.0",
    "marked": "^18.1.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
