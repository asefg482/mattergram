# Mattermost Server Configuration
MATTERMOST_BASE_URL=https://your-mattermost-server.com

# Show/Hide Mattermost Base URL in sidebar and settings (default: true)
SHOW_MATTERMOST_BASE_URL=true

# Web Push Notification Configuration (VAPID)
# VAPID_SUBJECT must be a valid email (mailto:...) or URL (https://...)
VAPID_SUBJECT=mailto:admin@example.com

# Optional: Fixed VAPID keys (if empty, keys are auto-generated and persisted in /app/data)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
